# Copy this to .env and fill in your values
DEFAULT_API_KEY=fade-dev-key-changeme
PORT=8080

# ── Blockchain (Polygon Amoy Testnet) ──────────────────────────────────────
# Set BLOCKCHAIN_ENABLED=true only after you have a deployed contract + wallet

# Step 1: Get a free test wallet from MetaMask (https://metamask.io)
#         Switch network to "Polygon Amoy Testnet"
# Step 2: Get free test MATIC from https://faucet.polygon.technology
# Step 3: Deploy blockchain/contract.sol in Remix IDE (https://remix.ethereum.org)
#         Copy the deployed contract address below
# Step 4: Set BLOCKCHAIN_ENABLED=true and restart the server

BLOCKCHAIN_ENABLED=false
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
WALLET_PRIVATE_KEY=0x_your_metamask_private_key_here
CONTRACT_ADDRESS=0x_your_deployed_contract_address_here
ANCHOR_INTERVAL_SECONDS=60

